{% set title = 'Blog' %}

{% extends '_layout.jinja2' %}

{% block content %}
  <header>
    <h1>Blog</h1>

    <p class="catchphrase">
      Writing is a kind of code
    </p>
    <p>
      CourtBouillon conceives high-quality apps and tools to help you
      give life to elegant documents, wonderful images, lovely texts, and more.
    </p>

    <ul class="tags">
      {% for class, tag in tags.items() %}
        {% if request.view_args.tag == class %}
          <li><a>{{ tag }}</a></li>
        {% else %}
          <li><a href="{{ url_for('blog', tag=class) }}">{{ tag }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </header>

  <main>
    {% for article in articles.values() %}
      <article>
        {% if article.image %}
          {% if article.image.startswith('/static/') or article.image.startswith('https://') %}
            <img src="{{ article.image }}" loading="lazy">
          {% else %}
            <img src="{{ url_for('static', filename=article.image) }}" loading="lazy">
          {% endif %}
        {% else %}
          <img src="{{ url_for('static', filename='images/article.svg', q=loop.index) }}" loading="lazy">
        {% endif %}
        <aside>
          {{ article.article_date }}
          {% if article.article_tags %}
            <ul class="tags">
              {% for tag in article.article_tags %}
                <li><a href="{{ url_for('blog', tag=tag) }}">{{ tags[tag] }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </aside>
        <h2>
          <a href="{{ url_for('blog', article=article.filename) }}">
            {{ article.title }}
          </a>
        </h2>
        {{ article.description }}
      </article>
    {% endfor %}

    {% if not request.view_args.tag %}
      <ul class="tags">
        {% for year in years | sort | reverse %}
          {% if request.view_args.year == year or (not request.view_args.year and loop.first) %}
            <li><a>{{ year }}</a></li>
          {% else %}
            <li><a href="{{ url_for('blog', year=year) }}">{{ year }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </main>
{% endblock content %}
